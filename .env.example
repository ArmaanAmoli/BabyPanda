# NVIDIA NIM API key.
# Create one at https://build.nvidia.com/ and keep the real value out of Git.
NVIDIA_API_KEY=your_nvidia_api_key_here

# Use the isolated test database when true. Set to false for the normal local
# database at ~/.babypanda/db/db.db.
IN_DEV_MODE=false

# Optional fixed port for the CLI's in-process HTTP and WebSocket server.
# Without this setting, BabyPanda automatically uses the first available port
# starting at 3500.
# BABY_PANDA_PORT=3500