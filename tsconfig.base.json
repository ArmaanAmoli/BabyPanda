{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noImplicitAny": true,
    "strict": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],
    "paths": {
      "*": ["./*"],
      "@/*": ["./*"]
    }
  },
  "include": ["**/*"]
}
