{
  "compilerOptions": {
    "rootDir": ".",
    "skipLibCheck": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "noImplicitAny": true,
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "types": ["bun"],
    "paths": {
      "*": ["./*"],
      "@/*": ["./*"],
      "@agent/*":["./packages/agent/*"],
      "@cli/*":["./packages/cli/src"]
    },
    "noUnusedParameters": true,
  },
  "include": ["packages/**/*"],
  "exclude": ["node_modules" , "dist" , "**/node_modules"]
}
